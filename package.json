{
  "name": "@bytadrian/puppeteer-real-browser",
  "version": "1.4.1",
  "description": "This package is designed to bypass puppeteer's bot-detecting captchas such as Cloudflare. It acts like a real browser and can be managed with puppeteer.",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.mjs",
  "exports": {
    ".": {
      "require": "./lib/cjs/index.js",
      "import": "./lib/esm/index.mjs",
      "types": "./typings.d.ts"
    }
  },
  "typings": "typings.d.ts",
  "scripts": {
    "test": "npm run test:cjs && npm run test:esm",
    "test:cjs": "node ./test/cjs/test.js",
    "test:esm": "node ./test/esm/test.js",
    "smoke:cjs": "node -e \"const { connect } = require('./lib/cjs/index.js'); if (typeof connect !== 'function') process.exit(1)\"",
    "smoke:esm": "node -e \"import('./lib/esm/index.mjs').then(({ connect }) => { if (typeof connect !== 'function') process.exit(1) })\"",
    "cjs_test": "npm run test:cjs",
    "esm_test": "npm run test:esm"
  },
  "keywords": [
    "cf-bypass",
    "cloudflare-bypass",
    "puppeteer-fingerprint",
    "puppeteer-cloudflare",
    "puppeteer-real-browser",
    "undetectable-puppeteer",
    "undetect",
    "undetectable",
    "puppeteer-undetectable",
    "puppeteer-undetect",
    "puppeteer-undetectable-bypass",
    "puppeteer-undetect-bypass",
    "puppeteer-undetectable-cloudflare",
    "puppeteer-undetect-cloudflare",
    "puppeteer-undetectable-cf",
    "puppeteer-undetect-cf",
    "puppeteer-undetectable-cf-bypass"
  ],
  "author": "zfc-software",
  "maintainers": [
    "bytAdrian"
  ],
  "license": "MIT",
  "dependencies": {
    "chrome-launcher": "^1.1.2",
    "ghost-cursor": "^1.3.0",
    "puppeteer-extra": "^3.3.6",
    "rebrowser-puppeteer-core": "^23.3.1",
    "tree-kill": "^1.2.2",
    "xvfb": "^0.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytAdrian/puppeteer-real-browser.git"
  },
  "bugs": {
    "url": "https://github.com/bytAdrian/puppeteer-real-browser/issues"
  },
  "readme": "README.md",
  "homepage": "https://github.com/bytAdrian/puppeteer-real-browser#readme"
}
